{
  "name": "@marktplatz/schema",
  "version": "0.1.0",
  "private": true,
  "description": "Contract layer (types + runtime validation) between the CLI and backend of the Skill-A/B-Marketplace. No runtime dependency on CLI or backend code.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:json-schema": "tsx scripts/export-json-schema.ts"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "tsx": "^4.16.2",
    "zod-to-json-schema": "^3.23.2"
  }
}
