# Superuser/owner connection — used only for `npm run migrate`.
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/skilldiff

# Runtime connection strings, one per role created by db/migrations/001_init.sql.
# In production these credentials belong in a secret store, not in .env.
APP_DATABASE_URL=postgres://app_backend:change-me-app-backend@localhost:5432/skilldiff
CONTENT_WRITER_DATABASE_URL=postgres://content_writer:change-me-content-writer@localhost:5432/skilldiff

# Optional — only read by `npm run migrate` (scripts/migrate.ts), to replace
# the change-me-* placeholders in 001_init.sql on a FRESH database. Set
# these (and keep APP_DATABASE_URL/CONTENT_WRITER_DATABASE_URL above in
# sync with the same values) for any real deployment; irrelevant for local
# dev against the docker-compose.yml defaults.
APP_BACKEND_ROLE_PASSWORD=
CONTENT_WRITER_ROLE_PASSWORD=
BLINDVOTING_ROLE_PASSWORD=

PORT=3000

# Comma-separated cli_build_hash values considered "official, unmodified"
# for the reputation weighting (briefing point 4). Populate from the CLI
# release process.
TRUSTED_CLI_BUILD_HASHES=

# Shown as SkillDetail.aggregationSourceUrl to the frontend (briefing 05
# point 6) — update once this repo has a real GitHub remote.
AGGREGATION_SOURCE_URL=https://github.com/example-org/skilldiff/tree/main/backend/src/aggregation
