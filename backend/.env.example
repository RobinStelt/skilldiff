# Superuser/owner connection — used only for `npm run migrate`.
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/marktplatz

# Runtime connection strings, one per role created by db/migrations/001_init.sql.
# In production these credentials belong in a secret store, not in .env.
APP_DATABASE_URL=postgres://app_backend:change-me-app-backend@localhost:5432/marktplatz
CONTENT_WRITER_DATABASE_URL=postgres://content_writer:change-me-content-writer@localhost:5432/marktplatz

PORT=3000

# Comma-separated cli_build_hash values considered "official, unmodified"
# for the reputation weighting (briefing point 4). Populate from the CLI
# release process.
TRUSTED_CLI_BUILD_HASHES=

# Shown as SkillDetail.aggregationSourceUrl to the frontend (briefing 05
# point 6) — update once this repo has a real GitHub remote.
AGGREGATION_SOURCE_URL=https://github.com/example-org/marktplatz/tree/main/backend/src/aggregation
