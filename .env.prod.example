# Production env for docker-compose.prod.yml. Copy to `.env`, fill in real
# values, keep it out of git (already covered by .gitignore's rule on
# top-level .env files — verify before committing anything named .env*).
#
#   cp .env.prod.example .env
#   openssl rand -base64 24   # run once per password line below
#   nano .env
#   bash deploy.sh            # see docker/README.md for the full walkthrough

# Public hostname this stack answers on — must match the Caddyfile block on
# the shared Caddy instance (see docker/README.md) and have a DNS A/AAAA
# record pointing at this server.
MARKETPLACE_DOMAIN=skilldiff.robin-steltmann.de

# Postgres superuser password (used only by the one-shot `migrate` service).
POSTGRES_SUPERUSER_PASSWORD=

# Runtime role passwords — go into both the `migrate` service (to set them
# on first run against a fresh database) and the `backend` service's
# connection strings. Change all three from the docker-compose.yml dev
# defaults; a fresh install with these left blank fails migrate.ts's
# MIGRATION_DATABASE_URL/role checks rather than silently using placeholders.
APP_BACKEND_ROLE_PASSWORD=
CONTENT_WRITER_ROLE_PASSWORD=
BLINDVOTING_ROLE_PASSWORD=

# Comma-separated cli_build_hash values considered "official, unmodified"
# for reputation weighting (see backend/README.md). Safe to leave empty —
# it just means no upload gets the build-hash trust bonus yet.
TRUSTED_CLI_BUILD_HASHES=
