{
  "name": "skill-ab",
  "version": "0.1.0",
  "private": true,
  "description": "CLI core of SkillDiff: runs a task with and without a skill, measures automatically, and force-uploads the result as a pair (Phase 2 from skill-ab-marktplatz-plan.md).",
  "type": "module",
  "bin": {
    "skill-ab": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@skilldiff/schema": "file:../schema",
    "commander": "^12.1.0",
    "picocolors": "^1.0.1",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/prompts": "^2.4.9",
    "typescript": "^5.5.4",
    "tsx": "^4.16.2",
    "vitest": "^2.0.5"
  }
}
