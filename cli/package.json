{
  "name": "skill-ab",
  "version": "0.1.0",
  "description": "CLI that runs a task once with a Claude Code or Codex skill available and once without, measures the difference automatically, and can upload the paired result to a SkillDiff marketplace.",
  "type": "module",
  "license": "MIT",
  "author": "Robin Steltmann",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RobinStelt/skilldiff.git",
    "directory": "cli"
  },
  "homepage": "https://skilldiff.robin-steltmann.de",
  "bugs": "https://github.com/RobinStelt/skilldiff/issues",
  "bin": {
    "skill-ab": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@skilldiff/schema": "file:../schema",
    "@types/node": "^20.14.15",
    "@types/prompts": "^2.4.9",
    "commander": "^12.1.0",
    "esbuild": "^0.28.2",
    "picocolors": "^1.0.1",
    "prompts": "^2.4.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
